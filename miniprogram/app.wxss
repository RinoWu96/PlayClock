/* Same palette as the desktop app (playclock/ui/theme.py). */
page {
  --bg: #0e1014;
  --card: #191d25;
  --card-hover: #212632;
  --border: #262b36;
  --text: #eceef2;
  --muted: #8b93a3;
  --faint: #5c6475;
  --accent: #6d8dff;
  --accent2: #a46dff;
  --green: #3ddc97;
  --orange: #ffb547;
  --danger: #ff6b6b;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page { padding: 24rpx 28rpx 60rpx; }
.card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section { font-size: 32rpx; font-weight: 600; margin: 12rpx 0 18rpx; }
.muted { color: var(--muted); }
.faint { color: var(--faint); font-size: 24rpx; }
.row { display: flex; align-items: center; }
.spread { display: flex; align-items: center; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* game avatar: gradient + initials, like the desktop fallback cover */
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 32rpx; color: #fff; flex-shrink: 0; margin-right: 22rpx;
}
.badge {
  display: inline-block; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 999rpx;
  background: var(--card-hover); color: var(--muted); margin-right: 8rpx;
}
.empty { text-align: center; color: var(--muted); padding: 80rpx 20rpx; line-height: 1.8; }
.btn {
  background: var(--accent); color: #fff; border-radius: 16rpx; font-size: 30rpx; font-weight: 600;
}
.btn-ghost { background: var(--card-hover); color: var(--text); border-radius: 16rpx; font-size: 28rpx; }
