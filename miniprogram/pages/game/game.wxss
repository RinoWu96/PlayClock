.hero { padding: 0 0 32rpx; overflow: hidden; }
.cover {
  height: 324rpx; overflow: hidden; display: flex; align-items: center; justify-content: center;
  font-size: 96rpx; font-weight: 700; color: rgba(255, 255, 255, 0.92); margin-bottom: 24rpx;
}
.hero .plats, .hero .title, .hero .total, .hero .faint { padding: 0 28rpx; }
.live { color: var(--green); }
.title { font-size: 40rpx; font-weight: 700; margin: 8rpx 0 16rpx; }
.total { font-size: 52rpx; font-weight: 700; }
.stats { display: flex; justify-content: space-between; }
.stat { width: 31%; box-sizing: border-box; padding: 22rpx; }
.stat-value { font-size: 30rpx; font-weight: 700; margin: 6rpx 0; }
.list { padding: 8rpx 28rpx; }
.item { padding: 18rpx 0; border-bottom: 1rpx solid var(--border); }
.item:last-child { border-bottom: none; }
